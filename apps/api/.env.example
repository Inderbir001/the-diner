NODE_ENV=development
PORT=4000

# Supabase → Project Settings → API. The service-role key must stay server-side.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The Vercel site (used for cache revalidation + email links) and allowed CORS origins
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://thediner.in,https://www.thediner.in

# Random strings, 32+ chars (e.g. `openssl rand -hex 32`). REVALIDATE_SECRET must match the web app.
REVALIDATE_SECRET=
CRON_SECRET=

# Email notifications via Resend (optional — without it emails are just logged)
RESEND_API_KEY=
EMAIL_FROM=The Diner Restobar <bookings@thediner.in>

# Social sync. Instagram can also be connected from /admin/social.
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

ENABLE_CRON=true
SYNC_CRON=*/30 * * * *
LOG_LEVEL=info
