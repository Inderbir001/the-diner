# Canonical site URL (no trailing slash) — used for SEO, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://thediner.in

# Supabase → Project Settings → API (the anon / publishable key is safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Render API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match REVALIDATE_SECRET on the API
REVALIDATE_SECRET=
